<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Consultorio Gonzalez</title>
</head>
<body style="margin:0; padding:0; background-color:#E8F2FB; font-family:Arial,Helvetica,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; background:#E8F2FB; padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="border-collapse:collapse; max-width:600px; width:100%; background:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 4px 24px rgba(42,59,72,0.10);">
          
          <!-- Header -->
          <tr>
            <td>
              {{> header}}
            </td>
          </tr>

          <!-- Línea decorativa -->
          <tr>
            <td style="height:4px; background: linear-gradient(90deg, #4382B5, #B8DAF5, #4382B5);"></td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px 48px;">
              {{{body}}}
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td>
              {{> footer}}
            </td>
          </tr>

        </table>

        <!-- Nota debajo del card -->
        <p style="font-family:Arial,sans-serif; font-size:11px; color:#4382B5; margin-top:20px; text-align:center;">
          Si tienes problemas con este correo, contáctanos directamente.
        </p>
      </td>
    </tr>
  </table>

</body>
</html>